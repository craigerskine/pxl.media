{%- macro mast(title,label,logo,ico) %}
{%- set slot = caller() -%}
<header class="group container mx-auto py-1 px-4 text-7xl leading-none flex items-center relative">
  <h1 {{- ' class="grow flex items-center justify-center space-x-5 lg:justify-start"' | safe if ico }}>
    <span class="flex items-center">
      {%- if logo %}
      <svg xmlns="http://www.w3.org/2000/svg" width="200" height="60" role="img" class="mx-auto w-auto h-16 fill-current lg:mx-0">
        <title>{{ title }}</title>
        <use href="{{ '/' | url }}_assets/platforms.svg?v={% bust %}#logo-{{ title | slugify }}" />
      </svg>
      {%- endif %}
      {%- if slot | trim != '' %}
        <b class="text-gray-200 tracking-tighter motion-safe:transition group-hover:(text-white)">{{ slot }}</b>
      {%- endif %}
      {%- if not logo and ico %}
        <iconify-icon icon="{{ ico }}" inline="false" class="text-6xl" noobserver></iconify-icon>
      {%- endif %}
    </span>
    {%- if label %}
      <b class="py-1 tracking-normal uppercase opacity-75 text-xl hidden sm:(block)">
        {{ label }}
      </b>
    {%- endif %}
  </h1>
</header>
{%- endmacro %}
