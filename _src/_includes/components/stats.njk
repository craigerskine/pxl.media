{#-
  cols: int
-#}
{%- macro stats(param) -%}
<div class="mx-auto px-4 w-full max-w-xs lg:mx-0">
  <div class="stats bg-gray-500/5 bg-gradient-to-br from-white/5 backdrop-blur-[1px] grid-(& cols-1) relative overflow-hidden shadow-solid before:(w-px bg-gradient-to-b from-white/20 absolute left-0.5 inset-y-0.5) after:(h-px bg-gradient-to-r from-white/20 absolute top-0.5 inset-x-0.5) lg:(grid-cols-{{ param.cols if param.cols else '4' }}) transition [&:has(a:hover)]:(translate-y-0.5 translate-x-0.5 shadow-[2px_2px_0_rgba(0,0,0,.5),3px_3px_0_rgba(255,255,255,.05)])">
  {{ caller() if caller }}
  </div>
</div>
{%- endmacro -%}

{#-
  tag: string
  ico: string
  value: string
  title: string
  url: string
  sub: [{
    title: string
    value: string
  }]
-#}
{%- macro stat(param) -%}
{%- set heading -%}{{ param.tag if param.tag else 'h2' }}{%- endset -%}
<div class="stat p-4 border-(1 gray-900) grid [grid-template-columns:repeat(1,1fr)] gap-4 relative">
  <div class="stat-figure w-12 h-12 col-start-2 row-start-1 row-span-1 opacity-50">
    <iconify-icon icon="{{ param.ico }}" class="text-5xl iconify" noobserver></iconify-icon>
  </div>
  <hgroup class="space-y-2">
    <{{ heading }} class="stat-value text-(gray-200 5xl) leading-[48px] tracking-tighter font-semibold">{{ param.value }}</{{ heading }}>
    <p>
      <a href="{{ (param.url | url) if param.url else '#' }}" class="stat-title group text-base leading-none font-semibold uppercase motion-safe:(transition) hover:(text-white)">
        {{ param.title }}
        <span class="absolute inset-0 z-10 after:(w-16 h-16 bg-brand-500/20 absolute top-2 right-2 opacity-75 motion-safe:(transition-all ease-in-out)) motion-safe:transition group-hover:(after:(w-full h-full top-0 right-0 opacity-100))"></span>
      </a>
    </p>
  </hgroup>
  <ul class="stat-desc font-semibold uppercase col-span-2 flex items-center gap-3">
    {%- for item in param.sub -%}
      <li class="text-xs">
        <strong class="sub-title mr-px text-(gray-200 sm) leading-none">{{ item.value }}</strong>
        <small class="sub-title opacity-70">{{ item.title }}</small>
      </li>
    {%- endfor -%}
  </ul>
</div>
{%- endmacro -%}
