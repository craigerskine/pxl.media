{%- macro category(title,subtext,url,bg_color='white/5',bg_img,fg_img,fg_ico,ico,svg_title) %}
  <li class="mx-auto lg:mx-0 w-full max-w-xs flex">
    <div class="category {{- ' group' if url }} mb-12 mx-4 pb-1 w-full flex flex-col relative motion-safe:transition [&:has(a:hover)]:(text-white)">
      <div class="mb-1 p-4 bg-gradient-to-br from-({{ bg_color }}) bg-(center contain no-repeat) backdrop-blur-[1px] text-gray-400 flex items-center relative overflow-hidden shadow-lg after:(content-[''] h-px bg-gradient-to-r from-transparent via-white/10 to-transparent absolute top-0 inset-x-0) motion-safe:(transition) group-hover:(text-white){% if bg_img %} h-32{% endif %}">
        <b class="ui-hover absolute inset-0 opacity-0 transform scale-50 motion-safe:(transition) group-hover:(bg-brand-500/20 opacity-100 scale-100)" aria-hidden="true"></b>
        {%- if bg_img %}
          <img src="{{ bg_img }}" alt="{{ title }}" class="w-full h-full bg-gradient-radial from-white/10 absolute inset-0 object-center object-contain pointer-events-none" />
        {%- endif %}
        {%- if fg_img %}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 60" role="img" class="w-auto h-12 max-w-full fill-current relative">
          <title>{{ title }}{{ (' '+ svg_title) if not title }}</title>
           <use href="{{ '/' | url }}_assets/platforms.svg?v={% bust %}#logo-{{ svg_title | slugify }}" />
        </svg>
        {%- endif %}
        {%- if fg_ico %}
        <iconify-icon icon="{{ fg_ico }}" class="text-5xl relative" noobserver></iconify-icon>
        {%- endif %}
        {%- if not bg_img %}
        {%- endif %}
      </div>
      <div class="meta pt-1 flex-(& col) gap-2 items-start">
        {% if title %}
        <{% if url %}a href="{{ url | url }}"{% else %}p{% endif %} class="name text-(white base) font-bold leading-none block line-clamp-1 {{- ' after:(absolute inset-0 content-[\'\'])' if url }}">
          {{ title }}
        </{% if url %}a{% else %}p{% endif %}>
        {% endif %}
        {%- if subtext %}
        <div class="leading-none pointer-events-none">
          <small class="ml-auto font-bold line-clamp-1 opacity-80" title="{{ subtext | striptags() | replace('/', ' / ') }}">{{ subtext | safe }}</small>
        </div>
        {%- endif %}
      </div>
    </>
  </li>
{%- endmacro %}
