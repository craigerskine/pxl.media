{#-
  contains both the default AND alpine
  components with shared classes
-#}

{%- set __game_list = 'pb-4 flex-(& wrap)' -%}
{%- set __game = 'mx-auto mb-8 px-4 w-full max-w-xs flex relative hover:z-20 focus-within:z-20 lg:mx-0' -%}
{%- set __box = 'group w-full bg-white/5 flex-(& wrap) relative rounded-lg ring-(inset 1 white/5) shadow-lg outline-(& 1 gray-950/50)' -%}
{%- set __box_cover = 'w-full h-16 bg-gray-950/90 flex relative overflow-hidden rounded-t-lg after:(w-full absolute inset-0 backdrop-brightness-75)' -%}
{%- set __box_cover_img = 'w-full h-16 object-(cover center) rounded-t-lg' -%}
{%- set __box_logo = 'w-full p-2 flex items-end justify-end absolute inset-y-0 right-0 z-10 before:(w-1/2 bg-gradient-to-l from-gray-950/90 via-gray-950/90 block absolute inset-y-0 right-0 rounded-tr-lg) after:(pointer-events-none ring-(inset 1 white/20) absolute inset-0 rounded-t-lg)' -%}
{%- set __box_logo_link = 'text-gray-200/75 block relative transition hover:text-gray-50' -%}
{%- set __box_logo_img = 'w-[80px] h-auto fill-current' -%}
{%- set __details = 'pb-1.5 border-(t gray-950/50) w-full flex' -%}
{%- set __meta = 'p-1.5 pt-3 pb-0 w-full min-w-0 flex-1 flex flex-col justify-between' -%}
{%- set __mast = 'mb-3' -%}
{%- set __name = 'px-1.5 text-(white base) font-black block truncate' -%}
{%- set __note = 'px-1.5 w-full min-w-0 text-(gray-400 xs) block truncate flex-1' -%}
{%- set __footer = 'p-1.5 w-full text-base flex items-center justify-between gap-3' -%}
{%- set __footer_line = '[--line-bg:rgb(255_255_255_/_.1)] [--line-shadow:0_-1px_0_rgb(0_0_0_/_.3)] h-px [background-color:var(--line-bg)] grow relative opacity-75 shadow-[var(--line-shadow)] [&:before,&:after]:(h-px [background-color:var(--line-bg)] absolute inset-x-0 -top-1 shadow-[var(--line-shadow)] content-[\'\']) [&:after]:top-1' -%}
{%- set __genres = 'flex items-center gap-3' -%}
{%- set __genres_link = 'text-lg flex items-center justify-center relative transition hover:text-gray-50' -%}
{%- set __tags = 'flex items-center gap-3' -%}
{%- set __tag = 'text-lg flex items-center justify-center relative opacity-50' -%}
{%- set __pending = 'w-2 h-2 text-brand-500 bg-current bg-gradient-to-b from-white/75 via-transparent cursor-pointer absolute top-2 right-2 z-10 rounded-full after:(ring-(2 current) absolute inset-0 z-10 rounded-full animate-ping)' -%}

{#-
  *** DEFAULT ***
-#}
{%- macro game(games=[],platforms=[],genres=[],by='data.title',reverse=false) -%}
  <ul class="game-list {{ __game_list }}">
    {%- for item in games | sort(reverse, false, by) %}
      <li class="game {{ __game }}">
        <figure class="box {{ __box }}">
          <div class="box-cover {{ __box_cover}}">
            <img src="{{ '/' | url }}_assets/img/games/{{ item.data.page.fileSlug }}.jpg" alt="Game box artwork for {{ item.data.title }}" class="box-cover-img {{ __box_cover_img }}" />
            <div class="box-logo {{ __box_logo }}">
              {%- for t in item.data.tags %}
              {%- for p in platforms %}
              {%- if p.data.page.fileSlug === t.replace('platform_', '') %}
              <a href="{{ '/' | url }}platform/{{ p.data.page.fileSlug }}/" class="box-logo-link {{ __box_logo_link }}">
                <svg xmlns="http://www.w3.org/2000/svg" width="200" height="60" role="img" class="box-logo-img {{ __box_logo_img }}">
                  <title>{{ p.data.title }}</title>
                  <use href="{{ '/' | url }}_assets/platforms.svg?v={% bust %}#logo-{{ p.data.title | slugify }}" />
                </svg>
              </a>
              {%- endif %}
              {%- endfor %}
              {%- endfor %}
            </div>
          </div>
          <figcaption class="details {{ __details }}">
            <div class="meta {{ __meta }}">
              <div class="mast {{ __mast }}">
                <b class="name {{ __name }}" title="{{ item.data.title }}">{{ item.data.title }}</b>
                <p class="note">
                  <i class="{{ __note }}" title="{{ item.data.note }}">{{ item.data.note | default('&nbsp;') | safe }}</i>
                </p>
              </div>
              <ul class="footer {{ __footer }}">
                <li>
                  <ul class="genres {{ __genres }}">
                    {%- for t in item.data.tags %}
                    {%- for g in genres %}
                    {%- if g.data.page.fileSlug === t.replace('genre_', '') %}
                    <li>
                      <a href="{{ '/' | url }}genre/{{ g.data.page.fileSlug }}/" x-tooltip="'{{ g.data.title }}'" class="genres-link {{ __genres_link }}" title="{{ g.data.title }}">
                        <iconify-icon icon="{{ g.data.ico }}" noobserver></iconify-icon>
                      </a>
                    </li>
                    {%- endif %}
                    {%- endfor %}
                    {%- endfor %}
                  </ul>
                </li>
                <li class="footer-line {{ __footer_line }}" aria-hidden="true"></li>
                <li>
                  <ul class="tags {{ __tags }}">
                  {%- for i in range(0, 3) -%}
                    {%- set labels = ['Physical', 'Digital', 'Guide'] -%}
                    {%- set tip = labels[i] -%}
                    {%- set icons = ['mdi:chip', 'mdi:qrcode', 'mdi:notebook'] -%}
                    {%- if (i === 0 and item.data.physical) or (i === 1 and item.data.digital) or (i === 2 and item.data.guide) %}
                      <li x-tooltip="'{{ tip }}'" class="tag {{ __tag }}" tabindex="0">
                        <iconify-icon icon="{{ icons[i] }}" noobserver></iconify-icon>
                      </li>
                    {%- endif %}
                  {%- endfor %}
                  </ul>
                </li>
              </ul>
            </div>
            {%- if item.data.pending %}
              <a href="{{ '/' | url }}games/pending/" x-tooltip="'Pending / Preordered'" class="pending {{ __pending }}">
                <span class="sr-only">Pending / Preordered</span>
              </a>
            {%- endif %}
          </figcaption>
        </figure>
      </li>
    {%- endfor %}
  </ul>
{%- endmacro -%}

{#-
  *** ALPINE ***
-#}
{%- macro game_alpine() -%}
  <li class="game {{ __game }}">
    <figure class="box {{ __box }}">
      <div class="box-cover {{ __box_cover }}">
        <img :src="'{{ '/' | url }}_assets/img/games/'+ item.id +'.jpg'" :alt="'Game box artwork for '+ item.title" class="box-cover-img {{ __box_cover_img }}" />
        <div class="box-logo {{ __box_logo }}">
          <a :href="'/platform/'+ slugify(item.platform.title) +'/'" class="box-logo-link {{ __box_logo_link }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="200" height="60" role="img" class="box-logo-img {{ __box_logo_img }}">
              <title x-text="item.platform.title"></title>
              <use :href="'{{ '/' | url }}_assets/platforms.svg?v={% bust %}#logo-'+ slugify(item.platform.title)" />
            </svg>
          </a>
        </div>
      </div>
      <figcaption class="details {{ __details }}">
        <div class="meta {{ __meta }}">
          <div class="mast {{ __mast }}">
            <b class="name {{ __name }}" :title="''+ item.title" x-text="item.title"></b>
            <p class="note">
              <i class="{{ __note }}" :title="''+ item.note" x-html="item.note ? item.note : '&nbsp;'"></i>
            </p>
          </div>
          <ul class="footer {{ __footer }}">
            <li>
              <ul class="genres {{ __genres }}">
                <template x-for="g in item.genre" :key="slugify(g.title)" hidden>
                  <li>
                    <a :href="'/genre/'+ slugify(g.title) +'/'" class="tag {{ __genres_link }}" x-tooltip="g.title">
                      <iconify-icon :icon="g.ico" noobserver></iconify-icon>
                    </a>
                  </li>
                </template>
              </ul>
            </li>
            <li class="footer-line {{ __footer_line }}" aria-hidden="true"></li>
            <li>
              <ul class="tags {{ __tags }}">
                <template x-for="i in 3" :key="i" hidden>
                  <template x-if="(i === 1 && item.physical) || (i === 2 && item.digital) || (i === 3 && item.guide)" hidden>
                    <li class="tag {{ __tag }}" tabindex="0" x-tooltip="i === 1 ? 'Physical' : i === 2 ? 'Digital' : i === 3 ? 'Guide' : ''">
                      <template x-if="i === 1" hidden>
                        <iconify-icon icon="mdi:chip" noobserver></iconify-icon>
                      </template>
                      <template x-if="i === 2" hidden>
                        <iconify-icon icon="mdi:qrcode" noobserver></iconify-icon>
                      </template>
                      <template x-if="i === 3" hidden>
                        <iconify-icon icon="mdi:notebook" noobserver></iconify-icon>
                      </template>
                    </li>
                  </template>
                </template>
              </ul>
            </li>
          </ul>
        </div>
        <template x-if="item.pending" hidden>
          <a href="{{ '/' | url }}games/pending/" x-tooltip="'Pending / Preordered'" class="pending {{ __pending }}">
            <span class="sr-only">Pending / Preordered</span>
          </a>
        </template>
      </figcaption>
    </figure>
  </li>
{%- endmacro -%}
